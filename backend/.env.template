APP_NAME="A4M Pets"
APP_ENV=local
APP_KEY=base64:generate_your_key_with_php_artisan_key_generate
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ====== DATABASE CONFIGURATION ======
# SQLite para desarrollo local
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Para producción, cambiar a MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=a4m_pets
# DB_USERNAME=root
# DB_PASSWORD=

# ====== SESSION ======
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ====== QUEUE ======
QUEUE_CONNECTION=sync

# ====== CACHE ======
CACHE_DRIVER=file
CACHE_PREFIX=

# ====== MAIL ======
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@a4mpets.local"
MAIL_FROM_NAME="${APP_NAME}"

# ====== AWS ======
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# ====== SYNC CONFIGURATION ======
# Configuración para sincronización de datos local-global
SYNC_CONFLICT_RESOLUTION=last_write_wins
SYNC_ARCHIVE_DAYS=90
