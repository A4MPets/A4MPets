          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"incident_latitude\": {{lat_iter}},\n  \"incident_longitude\": {{lng_iter}},\n  \"impact_radius_meters\": 50,\n  \"risk_level_code\": \"low\",\n  \"category_code\": \"traffic\",\n  \"estimated_duration_code\": \"temporary\",\n  \"description\": \"{{perf_hazard_description}} {{unique_suffix}}\",\n  \"narrative_description\": \"Carga F7 performance\"\n}" }, "url": "{{base_url}}/api/hazards" }
