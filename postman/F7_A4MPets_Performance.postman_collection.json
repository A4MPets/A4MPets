          "name": "F7-009 POST /api/routes/plan multipunto",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-009: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });", "pm.test('F7-009: ruta valida', function () { pm.expect(pm.response.json().data.coordinates).to.be.an('array'); });"] } }],
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"travel_mode\": \"car\",\n  \"avoid_hazards\": false,\n  \"points\": [\n    { \"lat\": 3.4516, \"lng\": -76.5320 },\n    { \"lat\": 3.4519, \"lng\": -76.5317 },\n    { \"lat\": 3.4522, \"lng\": -76.5314 },\n    { \"lat\": 3.4524, \"lng\": -76.5312 },\n    { \"lat\": 3.4525, \"lng\": -76.5311 }\n  ]\n}" }, "url": "{{base_url}}/api/routes/plan" }
