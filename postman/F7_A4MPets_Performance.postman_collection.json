        { "name": "F7-003 GET /api/lost-pet-reports", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-003 lost: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });", "pm.test('F7-003 lost: data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"] } }], "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/api/lost-pet-reports?per_page=20" } },
        { "name": "F7-003 GET /api/found-pet-reports", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-003 found: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });", "pm.test('F7-003 found: data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"] } }], "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/api/found-pet-reports?per_page=20" } },
        { "name": "F7-003 GET /api/generic-reports", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-003 generic: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });", "pm.test('F7-003 generic: data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"] } }], "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/api/generic-reports?per_page=20" } },
        { "name": "F7-004 GET /api/routes autenticado", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-004 routes: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });", "pm.test('F7-004 routes: data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"] } }], "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{base_url}}/api/routes?per_page=20" } },
        { "name": "F7-004 GET /api/pets autenticado", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-004 pets: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });", "pm.test('F7-004 pets: data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"] } }], "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{base_url}}/api/pets?per_page=20" } }
      ]
    },
    {
      "name": "F7-005/F7-007 - Fixed Write Load",
      "description": "Performance: fixed, 3-5 VU, 3-5 minutos. Escrituras ligeras con datos unicos.",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('active_threshold_ms', pm.environment.get('threshold_write_ms') || '3500');"] } }],
      "item": [
        {
          "name": "F7-005 POST /api/pets",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-005: HTTP 201', function () { pm.expect(pm.response.code).to.eql(201); });", "pm.test('F7-005: id mascota', function () { pm.expect(pm.response.json().data.id).to.exist; });"] } }],
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{perf_pet_name}}_{{unique_suffix}}\",\n  \"registered_at\": \"2026-05-11\",\n  \"adoption_date\": \"2025-01-10\",\n  \"birth_date\": \"2024-01-10\",\n  \"status\": \"normal\",\n  \"is_ownerless\": false\n}" }, "url": "{{base_url}}/api/pets" }
