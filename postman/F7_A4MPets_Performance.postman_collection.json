    {
      "name": "F7-008/F7-010 - GraphHopper Performance",
      "description": "Performance: fixed, 2-4 VU, 3-5 minutos. GraphHopper debe estar activo. Se usa modo car y puntos compactos para medir estabilidad API sin forzar rutas peatonales costosas en cada VU.",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('active_threshold_ms', pm.environment.get('threshold_route_ms') || '15000');"] } }],
      "item": [
