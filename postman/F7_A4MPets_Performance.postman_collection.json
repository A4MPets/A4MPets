{
  "info": {
    "_postman_id": "f7-a4mpets-performance",
    "name": "A4MPets F7 - Performance API Cloudflare",
    "description": "Coleccion F7 orientada a Postman Desktop Performance Testing. Ejecutar 00 - Setup primero con runner normal; luego ejecutar carpetas F7 desde la pestana Performance con perfil, VU y duracion indicados en README_F7.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const i = pm.info.iteration || 0;",
          "const baseLat = Number(pm.environment.get('lat_base') || 3.4516);",
          "const baseLng = Number(pm.environment.get('lng_base') || -76.5320);",
          "const suffix = `${Date.now()}_${i}_${Math.floor(Math.random() * 100000)}`;",
          "const data = pm.iterationData;",
          "pm.variables.set('perf_pet_name', data.get('pet_name') || `MascotaPerf_${suffix}`);",
          "pm.variables.set('perf_hazard_description', data.get('hazard_description') || `Peligro performance ${suffix}`);",
          "pm.variables.set('perf_comment_text', data.get('comment_text') || `Comentario performance ${suffix}`);",
          "pm.environment.set('unique_suffix', suffix);",
          "pm.environment.set('lat_iter', data.get('lat') || (baseLat + (i * 0.0001)).toFixed(6));",
          "pm.environment.set('lng_iter', data.get('lng') || (baseLng + (i * 0.0001)).toFixed(6));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('F7-global: no HTTP 5xx', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "const threshold = Number(pm.environment.get('active_threshold_ms') || 0);",
          "if (threshold > 0) {",
          "  pm.test(`F7-global: response time <= ${threshold}ms`, function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(threshold + 1);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "event": [
        {
          "listen": "prerequest",
          "script": { "type": "text/javascript", "exec": ["pm.environment.set('active_threshold_ms', pm.environment.get('threshold_login_ms') || '1500');"] }
        }
      ],
      "item": [
        {
          "name": "Setup - Health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Setup health: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
            "pm.test('Setup health: status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/api/health" }
        },
        {
          "name": "Setup - Login QA y guardar token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Setup login: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
            "const json = pm.response.json();",
            "pm.test('Setup login: contiene access_token', function () { pm.expect(json.data.access_token).to.be.a('string').and.not.empty; });",
            "pm.environment.set('access_token', json.data.access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"login\": \"{{qa_login}}\",\n  \"password\": \"{{qa_password}}\"\n}" },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Setup - Crear peligro base y guardar id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Setup hazard: HTTP 201', function () { pm.expect(pm.response.code).to.eql(201); });",
            "const json = pm.response.json();",
            "if (json.data && json.data.id) { pm.environment.set('hazard_id', json.data.id); pm.environment.set('created_hazard_id', json.data.id); }",
            "pm.test('Setup hazard: hazard_id disponible', function () { pm.expect(pm.environment.get('hazard_id')).to.not.be.empty; });"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"incident_latitude\": {{lat_iter}},\n  \"incident_longitude\": {{lng_iter}},\n  \"impact_radius_meters\": 50,\n  \"risk_level_code\": \"low\",\n  \"category_code\": \"traffic\",\n  \"estimated_duration_code\": \"temporary\",\n  \"description\": \"Peligro base F7 {{unique_suffix}}\",\n  \"narrative_description\": \"Peligro base para escenarios F7\"\n}" },
            "url": "{{base_url}}/api/hazards"
          }
        }
      ]
    },
    {
      "name": "F7-001/F7-002 - Baseline",
      "description": "Performance: fixed, 1 VU, 1-2 minutos. Objetivo: baseline sin carga concurrente.",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('active_threshold_ms', pm.environment.get('threshold_login_ms') || '1500');"] } }],
      "item": [
        {
          "name": "F7-001 Baseline GET /api/health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('F7-001: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
            "pm.test('F7-001: status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/api/health" }
        },
        {
          "name": "F7-002 Baseline POST /api/auth/login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('F7-002: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
            "const json = pm.response.json();",
            "pm.test('F7-002: access_token valido', function () { pm.expect(json.data.access_token).to.be.a('string').and.not.empty; });",
            "pm.environment.set('access_token', json.data.access_token);"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"login\": \"{{qa_login}}\",\n  \"password\": \"{{qa_password}}\"\n}" }, "url": "{{base_url}}/api/auth/login" }
        }
      ]
    },
    {
