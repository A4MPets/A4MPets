          "name": "F7-008 POST /api/routes/plan simple",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-008: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });", "const data = pm.response.json().data;", "pm.test('F7-008: ruta valida', function () { pm.expect(data.coordinates).to.be.an('array'); pm.expect(data.distance_meters).to.exist; pm.expect(data.duration_seconds).to.exist; });"] } }],
