          "name": "F7-007 POST /api/media/upload",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('F7-007: HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });", "pm.test('F7-007: url media', function () { pm.expect(pm.response.json().data.url).to.be.a('string').and.not.empty; });"] } }],
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"bucket\": \"pets\",\n  \"image_data\": \"{{image_base64}}\",\n  \"file_name\": \"f7-perf-{{unique_suffix}}.png\"\n}" }, "url": "{{base_url}}/api/media/upload" }
