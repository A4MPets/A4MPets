# Puertos publicados
BACKEND_PORT=8000
FRONTEND_PORT=8080
GRAPHHOPPER_PORT=8989
GRAPHHOPPER_ADMIN_PORT=8990

# URL publica del backend (usada por Laravel para generar URLs)
BACKEND_PUBLIC_URL=http://192.168.1.100:8000

# URL que usa el frontend web build en docker
FRONTEND_API_BASE_URL=http://192.168.1.100:8000/api

# Opcional para server compose
APP_DEBUG=false
